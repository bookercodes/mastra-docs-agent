KAPA_API_KEY=
KAPA_PROJECT_ID=2092d478-faff-4c3d-a807-033905335e52
# Full non-streaming Mastra generate endpoint:
MASTRA_AGENT_URL=https://mastra-docs-agent.server.mastra.cloud/api/agents/mastra-docs-agent/generate
# Optional bearer token if your Mastra endpoint requires it:
MASTRA_AUTH_TOKEN=

# Keep this file on persistent disk. Use a separate state file per target/project.
REPLAY_STATE_FILE=./replay-state.json
# First run only. Empty starts 60 seconds ago; set an ISO timestamp to backfill.
REPLAY_START_AT=
# Turns are posted sequentially. Unsent turns stay queued for the next cron run.
REPLAY_MAX_TURNS=20
REPLAY_TIMEOUT_SECONDS=180
# Retrieval-only searches are excluded by default. Add retrieval to include them.
REPLAY_QUERY_TYPES=conversation,agent_conversation,zendesk_agent_conv
# Optional comma-separated original Kapa thread IDs to exclude:
REPLAY_SKIP_THREAD_IDS=
