{
  "name": "mastra-docs-agent",
  "version": "1.0.0",
  "description": "A focused agent that answers Mastra questions using official documentation.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "mastra dev",
    "langfuse:remote": "NODE_ENV=development tsx --env-file=.env src/langfuse/server.ts",
    "build": "mastra build",
    "start": "mastra start",
    "braintrust:remote": "NODE_ENV=development braintrust eval src/braintrust/docs-agent.eval.ts --env-file .env --dev --dev-host 127.0.0.1 --dev-port 8300"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@langfuse/client": "^6.0.0",
    "@langfuse/otel": "^6.0.0",
    "@mastra/arize": "^1.3.25",
    "@mastra/braintrust": "^1.3.22",
    "@mastra/core": "1.78.0",
    "@mastra/evals": "^1.10.7",
    "@mastra/langfuse": "^1.6.1",
    "@mastra/langsmith": "^1.3.27",
    "@mastra/libsql": "1.26.2",
    "@mastra/memory": "1.38.0",
    "@mastra/observability": "1.20.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.223.0",
    "braintrust": "3.37.2",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "latest",
    "mastra": "1.34.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
