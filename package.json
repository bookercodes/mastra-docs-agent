{
  "name": "mastra-docs-agent",
  "version": "1.0.0",
  "description": "A focused agent that answers Mastra questions using official documentation.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "mastra dev",
    "langfuse:remote": "NODE_ENV=development tsx --env-file=.env src/langfuse/server.ts",
    "build": "mastra build",
    "start": "mastra start",
    "braintrust:remote": "NODE_ENV=development braintrust eval src/braintrust/docs-agent.eval.ts --env-file .env --dev --dev-host 127.0.0.1 --dev-port 8300"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@langfuse/client": "^6.0.1",
    "@langfuse/otel": "^6.0.1",
    "@mastra/arize": "^1.3.26",
    "@mastra/braintrust": "^1.3.23",
    "@mastra/core": "1.79.0",
    "@mastra/evals": "^1.10.8",
    "@mastra/langfuse": "^1.6.2",
    "@mastra/langsmith": "^1.3.28",
    "@mastra/libsql": "1.27.0",
    "@mastra/memory": "1.39.0",
    "@mastra/observability": "1.21.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "braintrust": "3.38.0",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "latest",
    "mastra": "1.35.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
